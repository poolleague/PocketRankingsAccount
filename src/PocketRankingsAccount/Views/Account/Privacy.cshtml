@model PlayerDataPrivacyStatus
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Privacy &amp; Player Data - Pocket Rankings Account</title>
<style>body{font-family:system-ui,sans-serif;max-width:760px;margin:0 auto;padding:2rem;color:#16231d;background:#f5f4ef}main{background:#fff;border:1px solid #d7ddd8;border-radius:14px;padding:clamp(1.2rem,4vw,2.2rem)}h1{line-height:1.1}.warning{border-left:5px solid #9d3d25;background:#fff4ef;padding:1rem}.status{background:#e6f1e9;padding:1rem;border-radius:8px}label{display:block;margin:1rem 0;font-weight:650}input[type=password]{display:block;width:100%;max-width:420px;padding:.7rem;margin-top:.35rem;font-size:1rem}.check{display:flex;gap:.7rem;align-items:flex-start}.check input{margin-top:.25rem}button{background:#8f2f1c;color:#fff;border:0;border-radius:7px;padding:.8rem 1rem;font-weight:700;min-height:44px}.errors{color:#8f2f1c}li{margin:.45rem 0}a{color:#176243}</style></head>
<body><main><p><a asp-controller="Home" asp-action="Index">← Account home</a></p><h1>Privacy &amp; Player Data</h1>
@if (Model.IsOptedOut) {
<section class="status" aria-live="polite"><h2>Permanent deletion is @Model.Status.Replace('_',' ')</h2><p>Your public profile is being removed. This request cannot be reversed.</p>@if(Model.RequestId is not null){<p>Request: <code>@Model.RequestId</code></p>}<ul>@foreach(var target in Model.Targets){<li>@target.ProductType.Replace('_',' '): @target.Status.Replace('_',' ')</li>}</ul></section>
} else {
<p>You may permanently opt out of Pocket Rankings maintaining player data while keeping your Account login, purchases, and product access.</p><section class="warning"><h2>This cannot be undone</h2><p>Confirming will:</p><ul><li>permanently delete your Player Profile, biography, photos, social links, achievements, statistics, and source links;</li><li>prevent future League and Tournament activity from recreating or updating that profile;</li><li>replace your identity in retained League and Tournament history with separate anonymous labels such as “Deleted player A7K4”;</li><li>preserve historical score sheets, standings, brackets, matches, results, placements, and payouts without a link back to you; and</li><li>make any later opt-in start over with future activity only.</li></ul><p>Your Account login, purchases, entitlements, and necessary security and transaction records will remain.</p></section>
<div asp-validation-summary="All" class="errors" role="alert"></div><form asp-action="OptOutPlayerData" method="post"><label>Current password<input type="password" name="CurrentPassword" autocomplete="current-password" required /></label><label class="check"><input type="checkbox" name="ConfirmPermanentDeletion" value="true" required /><span>I understand that all maintained player data will be permanently erased, retained competition history will identify me only as a deleted player, and the deleted information cannot be recovered.</span></label><button type="submit">Permanently erase my player data</button></form>
}</main></body></html>
