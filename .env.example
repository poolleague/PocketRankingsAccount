# Copy this file to .env and update the values before running docker compose.
# Never commit the real .env file (it's already in .gitignore).

COMPOSE_PROJECT_NAME=pocketrankingsaccount

# Where this product will eventually be reachable, once Caddy is wired to
# route here (see PLATFORM_AGENTS.md Section 1 open item). Not yet used by
# anything in this repo.
DOMAIN=account.pocketrankings.com

POSTGRES_DB=pocketrankingsaccount
POSTGRES_USER=pocketrankingsaccount
POSTGRES_PASSWORD=change-this-long-random-password-before-launch

ASPNETCORE_ENVIRONMENT=Production

# Required for login/signup/sessions to work -- generate with:
#   openssl rand -base64 32
# Must decode to at least 32 bytes or it's treated as not configured
# (AccountSecurityFoundationService.IsConfigured will be false, and
# login/signup/session calls throw). Never commit a real value.
ACCOUNT_SECURITY_FOUNDATION_HASH_KEY=

# Optional. PEM-encoded RSA private key for signing identity tokens.
# Generate with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt
# Leave empty for local dev -- an ephemeral key is generated automatically
# (see the startup warning this produces). Required before any other
# product could meaningfully verify a token Account issues, since without
# it every restart invalidates all previously-issued tokens and the
# published public key (/.well-known/jwks.json) changes too. Never commit
# a real value.
ACCOUNT_TOKEN_SIGNING_PRIVATE_KEY_PEM=

# Local dev/testing only -- see docker-compose.yml comment on the port
# mapping this controls.
HOST_PORT=8081
